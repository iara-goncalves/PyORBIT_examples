# LSBATCH: User input
#!/bin/sh 
### General options 
### -- specify queue -- 
#BSUB -q hpc
### -- set the job Name -- 
#BSUB -J DS1_3p_white_noise
### -- ask for number of cores (default: 1) -- 
#BSUB -n 24
### -- specify that the cores must be on the same host -- 
#BSUB -R "span[hosts=1]"
### -- specify that we need 1GB of memory per core/slot -- 
#BSUB -R "rusage[mem=1GB]"
### -- specify that we want the job to get killed if it exceeds 2GB per core/slot -- 
#BSUB -M 2GB
### -- set walltime limit: hh:mm -- 
#BSUB -W 8:00
### -- set the email address -- 
# #BSUB -u 
### -- send notification at start -- 
# #BSUB -B 
### -- send notification at completion -- 
# #BSUB -N 
### -- Specify the output and error file. %J is the job-id -- 
#BSUB -o Output_DS1_3p_white_noise.out 

# Change to activity directory
cd ../data/DS1/DS1_3p/DS1_3p_white_noise

# Clean up previous runs
rm -f configuration_file_emcee_run_DS1_3p_white_noise.log Output_DS1_3p_white_noise.out

# Activate PyORBIT environment
source /work2/lbuc/iara/anaconda3/etc/profile.d/conda.sh
conda activate pyorbit

# Run PyORBIT analysis
pyorbit_run emcee DS1_3p_white_noise.yaml > configuration_file_emcee_run_DS1_3p_white_noise.log
pyorbit_results emcee DS1_3p_white_noise.yaml -all >> configuration_file_emcee_run_DS1_3p_white_noise.log

# Create results directory and copy files
mkdir -p ./DS1_3p_white_noise
cp DS1_3p_white_noise.yaml ./DS1_3p_white_noise/
cp configuration_file_emcee_run_DS1_3p_white_noise.log ./DS1_3p_white_noise/

# Deactivate environment
conda deactivate

echo "Job DS1_3p_white_noise completed at: $(date)"

